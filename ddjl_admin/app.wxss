page {
  /* 小程序里 :root 变量兼容性不稳定，放到 page 上更稳 */
  --bg: #f7f8fa;
  --card: #ffffff;
  --text: #1f2937;
  --muted: #9ca3af;
  --primary: #ff758c;
  --primary2: #ff7eb3;
  --danger: #f87171;
  --border: #f3f4f6;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.04);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.muted {
  color: var(--muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--primary);
  color: #fff;
  font-weight: 700;
}

.btn.ghost {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid rgba(255, 117, 140, 0.6);
}

.btn.danger {
  background: var(--danger);
}

.input {
  height: 88rpx;
  border: 2rpx solid #f3f4f6;
  border-radius: 28rpx;
  padding: 0 22rpx;
  background: #fff;
  font-weight: 600;
  color: var(--text);
}

.h1 {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.h2 {
  font-size: 36rpx;
  font-weight: 900;
}

.shadow-pink {
  box-shadow: 0 18rpx 40rpx rgba(255, 117, 140, 0.18);
}

.pill {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 117, 140, 0.12);
  color: var(--primary);
  font-weight: 800;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}


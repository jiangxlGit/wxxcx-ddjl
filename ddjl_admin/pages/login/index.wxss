.page {
  --edge-gap: 86rpx;
  --main-offset: 12.5vh;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 0 42rpx calc(240rpx + env(safe-area-inset-bottom));
  background: #efecf5;
}

.bg-decor {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.bg-decor-top {
  width: 520rpx;
  height: 520rpx;
  top: -260rpx;
  right: -180rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.74) 0%, rgba(255, 255, 255, 0) 72%);
}

.bg-decor-bottom {
  width: 460rpx;
  height: 460rpx;
  left: -160rpx;
  bottom: -220rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 70%);
}

.bg-decor,
.brand-wrap,
.auth-card {
  transform: translateY(var(--main-offset));
}

.brand-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--edge-gap);
}

.logo-ring {
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  background: #f8f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(130, 115, 168, 0.1);
}

.logo-core {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c23d75 0%, #e487ac 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-figure {
  width: 98rpx;
  height: 98rpx;
  display: block;
}

.brand-title {
  margin-top: 48rpx;
  font-size: 56rpx;
  line-height: 1.1;
  letter-spacing: 1.5rpx;
  font-weight: 400;
  font-style: normal;
  font-family: -apple-system, "PingFang SC", "SF Pro Text", "Helvetica Neue", sans-serif;
  color: #b62b66;
  text-shadow: none;
  transform: none;
}

.brand-subtitle {
  margin-top: 26rpx;
  font-size: 30rpx;
  line-height: 1.28;
  letter-spacing: 1rpx;
  color: #7b7b84;
  font-weight: 500;
}

.auth-card {
  position: relative;
  z-index: 1;
  margin-top: 120rpx;
  border-radius: 58rpx;
  border: 2rpx solid rgba(227, 224, 233, 0.9);
  background: rgba(247, 247, 250, 0.9);
  box-shadow: 0 10rpx 30rpx rgba(109, 98, 138, 0.05);
  padding: 54rpx 40rpx 52rpx;
}

.wechat-btn {
  width: 100%;
  height: 108rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 56rpx;
  background: linear-gradient(90deg, #c13f77 0%, #e88aad 100%);
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-align: center;
  line-height: 108rpx;
  box-shadow: 0 14rpx 32rpx rgba(193, 63, 119, 0.22);
}

.wechat-btn::after {
  border: none;
}

.wechat-btn[disabled] {
  opacity: 0.84;
}

.agreement-row {
  margin-top: 46rpx;
  display: flex;
  align-items: flex-start;
}

.agreement-checkbox {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
  border: 2rpx solid #b8bbc1;
  background: #f7f7f8;
  margin-right: 18rpx;
  margin-top: 3rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: border-color 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
}

.agreement-checkbox.is-checked {
  border-color: #c24d7c;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(194, 77, 124, 0.08);
}

.agreement-checkbox.checkbox-bounce {
  animation: checkbox-bounce 240ms cubic-bezier(0.2, 0.9, 0.3, 1);
}

.check-ripple {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  pointer-events: none;
  background: rgba(194, 77, 124, 0.18);
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.2);
}

.check-ripple.ripple-in {
  animation: ripple-in 280ms ease-out;
}

.check-mark {
  width: 20rpx;
  height: 20rpx;
  position: relative;
  z-index: 1;
  opacity: 0;
  transform-origin: 50% 56%;
  transform: scale(0.2) rotate(-16deg);
}

.check-mark.check-in {
  animation: check-in 280ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

.check-mark.check-out {
  opacity: 0;
  transform: scale(0.2) rotate(-16deg);
}

.check-line {
  position: absolute;
  height: 4rpx;
  border-radius: 999rpx;
  background: #c24d7c;
  opacity: 0;
  transform-origin: left center;
}

.check-line-short {
  width: 8rpx;
  left: 2rpx;
  top: 11rpx;
  transform: rotate(42deg) scaleX(0);
}

.check-line-long {
  width: 15rpx;
  left: 7rpx;
  top: 10rpx;
  transform: rotate(-44deg) scaleX(0);
}

.check-mark.check-in .check-line-short {
  animation: check-line-short-in 150ms ease-out 70ms forwards;
}

.check-mark.check-in .check-line-long {
  animation: check-line-long-in 170ms ease-out 140ms forwards;
}

.agreement-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.6;
  color: #777a82;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  word-break: keep-all;
}

.agreement-link {
  color: #bf4475;
}

.bottom-subtitle {
  position: absolute;
  left: 42rpx;
  right: 42rpx;
  bottom: var(--edge-gap);
  margin-top: 0;
  text-align: center;
}

@keyframes check-in {
  0% {
    opacity: 0;
    transform: scale(0.2) rotate(-20deg);
  }

  65% {
    opacity: 1;
    transform: scale(1.14) rotate(2deg);
  }

  100% {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
}

@keyframes ripple-in {
  0% {
    opacity: 0.56;
    transform: translate(-50%, -50%) scale(0.2);
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.1);
  }
}

@keyframes checkbox-bounce {
  0% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.12);
  }

  100% {
    transform: scale(1);
  }
}

@keyframes check-line-short-in {
  0% {
    opacity: 0;
    transform: rotate(42deg) scaleX(0);
  }

  100% {
    opacity: 1;
    transform: rotate(42deg) scaleX(1);
  }
}

@keyframes check-line-long-in {
  0% {
    opacity: 0;
    transform: rotate(-44deg) scaleX(0);
  }

  100% {
    opacity: 1;
    transform: rotate(-44deg) scaleX(1);
  }
}

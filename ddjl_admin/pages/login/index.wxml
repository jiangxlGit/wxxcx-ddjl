<view class="page">
  <view class="bg-decor bg-decor-top"></view>
  <view class="bg-decor bg-decor-bottom"></view>

  <view class="brand-wrap">
    <view class="logo-ring">
      <view class="logo-core">
        <image class="logo-figure" src="/assets/login-figure.png" mode="aspectFit"></image>
      </view>
    </view>
    <view class="brand-title">叮叮教练</view>
  </view>

  <view class="auth-card">
    <button class="wechat-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onWechatLogin">
      微信一键登录
    </button>

    <view class="agreement-row">
      <view class="agreement-checkbox {{agreed ? 'is-checked checkbox-bounce' : ''}}" bindtap="toggleAgreement">
        <view class="check-ripple {{agreed ? 'ripple-in' : ''}}"></view>
        <view class="check-mark {{agreed ? 'check-in' : 'check-out'}}">
          <view class="check-line check-line-short"></view>
          <view class="check-line check-line-long"></view>
        </view>
      </view>
      <view class="agreement-text">
        我已阅读并同意
        <text class="agreement-link" data-type="service" catchtap="onOpenAgreement">《用户服务协议》</text>
        与
        <text class="agreement-link" data-type="privacy" catchtap="onOpenAgreement">《隐私权政策》</text>
      </view>
    </view>
  </view>

  <view class="brand-subtitle bottom-subtitle">您的私人运动成长管家</view>
</view>

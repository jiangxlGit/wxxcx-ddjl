<view class="page">
  <view class="container safe-bottom">
    <view class="center">
      <view class="avatarWrap">
        <image class="avatar" src="{{form.avatar}}" mode="aspectFill" />
        <view class="pen">✎</view>
      </view>
    </view>

    <view class="form">
      <view class="field">
        <view class="label">姓名</view>
        <input class="input2" value="{{form.name}}" bindinput="onName" />
      </view>

      <view class="field">
        <view class="label">手机号码</view>
        <input class="input2" type="number" value="{{form.phone}}" bindinput="onPhone" placeholder="输入手机号" />
      </view>

      <view class="grid">
        <view class="field">
          <view class="label">课时总数</view>
          <input class="input2" type="number" value="{{form.totalLessons}}" bindinput="onTotalLessons" />
        </view>
        <view class="field">
          <view class="label">课程单价</view>
          <input class="input2" type="number" value="{{form.lessonPrice}}" bindinput="onLessonPrice" />
        </view>
      </view>

      <view class="field">
        <view class="label">备注 (身体状况/目标)</view>
        <textarea class="ta" value="{{form.note}}" bindinput="onNote" placeholder="例如：核心训练/减脂需求..." />
      </view>
    </view>
  </view>

  <view class="bottom-action">
    <button class="bottom-btn save-btn" bindtap="onSave">保存</button>
  </view>
</view>
